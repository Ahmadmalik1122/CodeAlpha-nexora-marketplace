{
  "name": "nexora-marketplace",
  "version": "1.0.0",
  "description": "Nexora Marketplace — a full-stack PC hardware marketplace (Node.js, Express, PostgreSQL/Supabase). Buyers shop premium hardware from trusted sellers; admins manage the platform.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/init.js",
    "seed": "node db/init.js",
    "init": "node db/init.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ecommerce",
    "marketplace",
    "pc-hardware",
    "express",
    "postgresql",
    "supabase",
    "nodejs"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.12.0"
  }
}
