# Copy to `.env` and adjust. Never commit `.env`.
# Nexora Marketplace is configured for Pakistani Rupees (PKR) out of the box.

# --- Database (REQUIRED) ---
# Your Supabase PostgreSQL connection string, e.g.:
#   postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Server ---
PORT=3000
NODE_ENV=development
# Use a long random string in production.
SESSION_SECRET=nexora-dev-secret-change-me

# --- Shipping rules (PKR) ---
SHIPPING_FEE=350
FREE_SHIP_THRESHOLD=25000

# --- Security (optional) ---
# TRUST_PROXY=
# COOKIE_SECURE=false

# --- Email (Gmail SMTP, for password reset links) ---
# GMAIL_USER = the full Gmail address you're sending from.
# GMAIL_APP_PASSWORD = a 16-character Google "App Password" (NOT your normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords — requires 2-Step
# Verification to be enabled on the Google account first.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: override the "From" header, e.g. "Nexora Marketplace <you@gmail.com>"
MAIL_FROM=

# --- Payment gateway keys (placeholders for Stripe / JazzCash / EasyPaisa integrations) ---
# Online card payments are simulated as paid in demo mode.
STRIPE_SECRET_KEY=
JAZZCASH_MERCHANT_ID=
EASYPAISA_STORE_ID=